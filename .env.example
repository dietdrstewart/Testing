# American Airlines
AA_USERNAME=your_email@example.com
AA_PASSWORD=your_aa_password

# Marriott Bonvoy
MARRIOTT_USERNAME=your_email@example.com
MARRIOTT_PASSWORD=your_marriott_password

# Gmail SMTP — use an App Password, NOT your account password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Your wife's email address
NOTIFY_EMAIL=wifes_email@example.com

# App settings
POLL_INTERVAL_MINUTES=5
STATE_FILE_PATH=~/.travel_notifier_state.json
COOKIE_DIR=~/.travel_notifier_cookies

# Set True on first run so you can see the browser and solve any CAPTCHAs manually.
# After cookies are saved, switch to False for headless background operation.
HEADED_BROWSER=True

# Hour (0-23) to send hotel check-in day reminder (default 8 = 8 AM)
CHECKIN_NOTIFY_HOUR=8

LOG_LEVEL=INFO
